{
  "name": "ngx-convex",
  "version": "0.0.1",
  "description": "Angular bindings for Convex: signal-based live queries, mutations, actions, pagination, file storage and the Convex Auth 2.0 client.",
  "keywords": [
    "angular",
    "convex",
    "signals",
    "realtime",
    "convex-auth"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tibdev78/ngx-convex.git",
    "directory": "projects/ngx-convex"
  },
  "homepage": "https://github.com/tibdev78/ngx-convex#readme",
  "bugs": "https://github.com/tibdev78/ngx-convex/issues",
  "peerDependencies": {
    "@angular/common": "^17.3.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^17.3.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "convex": "^1.48.0",
    "@convex-dev/auth": "^2.0.0",
    "@simplewebauthn/browser": "^14.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": false,
  "peerDependenciesMeta": {
    "@convex-dev/auth": {
      "optional": true
    },
    "@simplewebauthn/browser": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "convex-auth": [
        "./types/ngx-convex-convex-auth.d.ts"
      ],
      "testing": [
        "./types/ngx-convex-testing.d.ts"
      ]
    }
  }
